# Copy to .env.local and fill in. Never commit real values.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security, which is the entire tenant
# boundary. Never expose it to the web client or ship it in the mobile bundle.
# Required by `npm run onboard`, which is the only thing that can create a centre.
SUPABASE_SERVICE_ROLE_KEY=

# --- Running the RLS suite (`npm run test:rls`) ------------------------------
# Either block below works. The suite always ends in ROLLBACK, so it is safe to
# point at a live project.

# Preferred, and what CI should use. Dashboard -> Settings -> Database ->
# Connection string (URI). Scoped to one database, so a leaked value reaches one
# project.
SUPABASE_DB_URL=

# Fallback, for when you have a personal access token but not the database
# password — the normal state on a project you did not create locally. Real cost
# attached: a PAT is ACCOUNT-WIDE and can reach every project on the account,
# including production ones with nothing to do with this repo. Fine on a laptop,
# wrong in CI.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Mobile (Expo inlines anything prefixed EXPO_PUBLIC_ into the binary) ---
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

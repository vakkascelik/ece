node_modules/
.next/
out/
dist/
build/
.expo/
*.tsbuildinfo

# database backups — contain user emails and user-generated content, i.e.
# personal data. Never commit them.
.backups/

# secrets — the service-role key bypasses RLS, which is the only thing
# separating one centre's children from another's
.env
.env.*
!.env.example

.DS_Store
*.log

# Playwright — the audit's own artefacts. `tenant.json` names a throwaway account and
# holds its password for the length of a run; it must never be committed.
# Matched at ANY depth, on purpose. These files held `sb-<project>-auth-token` — a
# Supabase access AND refresh token for a live account — and a path-specific rule missed
# them once already, because Playwright resolves storageState against the process cwd
# rather than against its config file. See apps/web/e2e/fixtures/paths.ts.
**/e2e/.artifacts/
apps/web/test-results/
apps/web/playwright-report/

# cPanel audit output — holds real mailbox addresses for a client's domain,
# i.e. personal data, same category as .backups/. The zone file is promoted into
# docs/ by hand after review; the rest never leaves this machine.
.audit/

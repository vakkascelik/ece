{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@ece/core": ["../../packages/core/src/index.ts"],
      "@ece/api": ["../../packages/api/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "// exclude": [
    "e2e is excluded because `next build` typechecks whatever this file includes, and",
    "the audit imports @playwright/test and node:crypto — a bundler-resolution,",
    "browser-lib project. It is not unchecked: e2e/tsconfig.json checks it under node,",
    "and `npm run typecheck` runs both."
  ],
  "exclude": ["node_modules", "e2e"]
}

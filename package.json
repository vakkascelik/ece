{
  "name": "ece",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant platform for New Zealand early learning services. Web admin plus a mobile app for whanau and educators, one deployment serving every centre.",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @ece/web",
    "dev:mobile": "npm run start -w @ece/mobile",
    "build": "npm run build -w @ece/core && npm run build -w @ece/api && npm run build -w @ece/web && npm run build -w @ece/site",
    "build:site": "npm run build -w @ece/core && npm run build -w @ece/site",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:rls": "node --env-file-if-exists=.env.local --import tsx scripts/test-rls.ts",
    "onboard": "node --env-file-if-exists=.env.local --import tsx scripts/onboard.ts",
    "seed:demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "tokens": "tsx scripts/tokens-css.ts",
    "tokens:check": "tsx scripts/tokens-css.ts --check",
    "drill:offline": "node --env-file-if-exists=.env.local --import tsx scripts/offline-drill.ts",
    "import:criteria": "node --env-file-if-exists=.env.local --import tsx scripts/import-criteria.ts",
    "import:storypark": "node --env-file-if-exists=.env.local --import tsx scripts/import-storypark.ts",
    "import:discover": "node --env-file-if-exists=.env.local --import tsx scripts/import-discover.ts",
    "check:docs": "tsx scripts/check-docs-links.ts",
    "sweep:media": "node --env-file-if-exists=.env.local --import tsx scripts/sweep-orphan-media.ts",
    "reconcile:funding": "node --env-file-if-exists=.env.local --import tsx scripts/reconcile-funding.ts",
    "test:e2e": "npm run build && node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test -c apps/web/playwright.config.ts",
    "test:e2e:ui": "node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test -c apps/web/playwright.config.ts --ui",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "drill:restore": "node --env-file-if-exists=.env.local --import tsx scripts/restore-drill.ts",
    "review:security": "node --env-file-if-exists=.env.local --import tsx scripts/security-review.ts",
    "sweep:audit": "node --env-file-if-exists=.env.local --import tsx scripts/sweep-audit-tenants.ts",
    "deploy:auth": "node --env-file-if-exists=.env.local --import tsx scripts/deploy-auth-config.ts",
    "drill:rowcap": "node --env-file-if-exists=.env.local --import tsx scripts/drill-rowcap.ts",
    "audit:site": "node --import tsx scripts/audit-site.ts",
    "schedule:run": "node --env-file-if-exists=.env.local --import tsx scripts/run-scheduled.ts",
    "icons:mobile": "tsx scripts/mobile-icons.ts",
    "audit:cpanel": "node --env-file-if-exists=.env.migration --import tsx scripts/audit-cpanel.ts",
    "cf:plan": "node --env-file-if-exists=.env.migration --import tsx scripts/cloudflare-zone-plan.ts",
    "dns:diff": "node --env-file-if-exists=.env.migration --import tsx scripts/dns-diff.ts",
    "cf:stage-c": "node --env-file-if-exists=.env.migration --import tsx scripts/cloudflare-stage-c.ts",
    "cf:stage-d": "node --env-file-if-exists=.env.migration --import tsx scripts/cloudflare-stage-d.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/pg": "^8.20.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pg": "^8.22.0",
    "tsx": "^4.23.5",
    "typescript-eslint": "^8.66.0"
  },
  "browserslist": [
    "chrome 64",
    "edge 79",
    "firefox 67",
    "opera 51",
    "safari 12"
  ]
}

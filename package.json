{
  "name": "ece",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant platform for New Zealand early learning services. Web admin plus a mobile app for whanau and educators, one deployment serving every centre.",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @ece/web",
    "dev:mobile": "npm run start -w @ece/mobile",
    "build": "npm run build -w @ece/core && npm run build -w @ece/api && npm run build -w @ece/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:rls": "node --env-file-if-exists=.env.local --import tsx scripts/test-rls.ts",
    "onboard": "node --env-file-if-exists=.env.local --import tsx scripts/onboard.ts",
    "seed:demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "tokens": "tsx scripts/tokens-css.ts",
    "tokens:check": "tsx scripts/tokens-css.ts --check",
    "drill:offline": "node --env-file-if-exists=.env.local --import tsx scripts/offline-drill.ts",
    "import:criteria": "node --env-file-if-exists=.env.local --import tsx scripts/import-criteria.ts",
    "check:docs": "tsx scripts/check-docs-links.ts",
    "sweep:media": "node --env-file-if-exists=.env.local --import tsx scripts/sweep-orphan-media.ts",
    "reconcile:funding": "node --env-file-if-exists=.env.local --import tsx scripts/reconcile-funding.ts",
    "test:e2e": "npm run build && node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test -c apps/web/playwright.config.ts",
    "test:e2e:ui": "node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test -c apps/web/playwright.config.ts --ui",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "drill:restore": "node --env-file-if-exists=.env.local --import tsx scripts/restore-drill.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/pg": "^8.20.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pg": "^8.22.0",
    "tsx": "^4.23.5",
    "typescript-eslint": "^8.66.0"
  }
}
